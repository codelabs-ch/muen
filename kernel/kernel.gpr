with "shared";
with "policy";
with "crash_audit";
with "common_strings";

with "muen_common";
with "muinterrupts";
with "muschedinfo";
with "mutimedevents";

project Kernel is

   type Build_Type is ("debug", "release", "prove");
   Build_Mode : Build_Type := external ("MUEN_BUILD_MODE");

   Extra_Dirs := ();
   Extra_Languages := ();
   Extra_Warning_Switches := ();
   Extra_Compiler_Switches := ();
   Preprocessor_Switches := ();
   MCU_Pkg := "";
   Mitigations_Pkg := "";
   MCU_Mitigations_Pkg := "";
   VM_Entry_Pkg := "";
   VM_Entry_Ibpb_Pkg := "";
   VM_Entry_Verw_Pkg := "";
   VM_Entry_L1d_Flush_Pkg := "";

   case Build_Mode is
      when "debug" =>
         Extra_Dirs := Extra_Dirs & Build_Mode;
         Extra_Languages := ("Asm_Cpp");
         Preprocessor_Switches :=
           ("-gnateDRelease_Warnings=Ignored_Warnings");
         Extra_Warning_Switches := Shared.Build_Warning_Switches;

         case Policy.Debug_Type is
            when "uart" | "hsuart" =>
               Extra_Dirs := Extra_Dirs
                 & (Build_Mode & "/console/serial",
                    Build_Mode & "/console/serial/" & Policy.Debug_Type);
            when others =>
               Extra_Dirs := Extra_Dirs
                 & (Build_Mode & "/console/" & Policy.Debug_Type);
         end case;

      when "release" =>
         Extra_Dirs := Extra_Dirs & Build_Mode;
         Extra_Languages := ("Asm_Cpp");
         Preprocessor_Switches :=
           ("-gnateDRelease_Warnings=Warnings");
         Extra_Warning_Switches := Shared.Build_Warning_Switches;
         Extra_Compiler_Switches := ("-O2");

      when "prove" =>
         Extra_Dirs := Extra_Dirs
           & ("release", "spark");
         Preprocessor_Switches :=
           ("-gnateDRelease_Warnings=Warnings");
   end case;

   case Policy.Has_Multiple_Major_Frames is
      when "True" =>
         case Build_Mode is
            when "debug"
               | "release" =>
               Preprocessor_Switches := Preprocessor_Switches &
               ("-gnateDMajor_Frame_Warnings=Ignored_Warnings");
            when "prove" =>
               Preprocessor_Switches := Preprocessor_Switches &
               ("-gnateDMajor_Frame_Warnings=Warnings");
         end case;
      when "False" =>
         Preprocessor_Switches := Preprocessor_Switches &
         ("-gnateDMajor_Frame_Warnings=Warnings");
   end case;

   case Policy.MCU_Enabled is
      when "True"  => MCU_Pkg := "enabled";
      when "False" => MCU_Pkg := "disabled";
   end case;

   --  Select the SK.Mitigations and SK.Mitigations.MCU package bodies:
   --  without the mitigation policy both are "disabled" (null checks). With
   --  the policy enabled, the MCU revision floor (SK.Mitigations.MCU) is
   --  always checked, while the ARCH_CAP check (SK.Mitigations) is "enabled"
   --  only when the policy requires IA32_ARCH_CAPABILITIES bits - otherwise
   --  it is compiled out entirely, as the MSR may not be readable on such a
   --  target (empty <archCapabilities/> at collection time). The VM-entry
   --  mitigations (SK.Mitigations.VM_Entry) follow the same pattern: their
   --  body is "enabled" only when a vmEntry mitigation leaf is enabled.
   case Policy.Mitigations_Enabled is
      when "True" =>
         MCU_Mitigations_Pkg := "enabled";
         case Policy.Arch_Cap_Check_Enabled is
            when "True"  => Mitigations_Pkg := "enabled";
            when "False" => Mitigations_Pkg := "disabled";
         end case;
         case Policy.VM_Entry_Enabled is
            when "True"  => VM_Entry_Pkg := "enabled";
            when "False" => VM_Entry_Pkg := "disabled";
         end case;
         case Policy.VM_Entry_Ibpb_Enabled is
            when "True"  => VM_Entry_Ibpb_Pkg := "enabled";
            when "False" => VM_Entry_Ibpb_Pkg := "disabled";
         end case;
         case Policy.VM_Entry_Verw_Enabled is
            when "True"  => VM_Entry_Verw_Pkg := "enabled";
            when "False" => VM_Entry_Verw_Pkg := "disabled";
         end case;
         case Policy.VM_Entry_L1d_Flush_Enabled is
            when "True"  => VM_Entry_L1d_Flush_Pkg := "enabled";
            when "False" => VM_Entry_L1d_Flush_Pkg := "disabled";
         end case;
      when "False" =>
         MCU_Mitigations_Pkg    := "disabled";
         Mitigations_Pkg        := "disabled";
         VM_Entry_Pkg           := "disabled";
         VM_Entry_Ibpb_Pkg      := "disabled";
         VM_Entry_Verw_Pkg      := "disabled";
         VM_Entry_L1d_Flush_Pkg := "disabled";
   end case;

   for Languages use ("Ada") & Extra_Languages;

   for Source_Dirs use (
      "src/**", external("POLICY_SRC_DIR"), external("VERSION_DIR")) &
     Extra_Dirs;

   for Object_Dir use external("OBJ_DIR","obj/") & Build_Mode;

   for Main use ("init");

   package Builder is
      for Executable ("init.S") use "kernel";
      for Global_Configuration_Pragmas use external("BUILD_CFG_PATH") &  "/restrictions.adc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use Shared.No_FPU_Switches
        & Shared.Spark_Compiler_Switches
        & Extra_Compiler_Switches
        & Preprocessor_Switches
        & Shared.Warning_Switches
        & Extra_Warning_Switches;
      for Local_Configuration_Pragmas use external("BUILD_CFG_PATH") & "/restrictions-" & Build_Mode & ".adc";
   end Compiler;

   package Linker is
      for Default_Switches ("Asm_Cpp") use Shared.Spark_Linker_Switches;
   end Linker;

   package Naming is
      for Body_Suffix ("Asm_Cpp") use ".S";
      for Body ("SK.MCU") use "sk-mcu__" & MCU_Pkg & ".adb";
      for Body ("SK.Mitigations") use "sk-mitigations__" & Mitigations_Pkg & ".adb";
      for Body ("SK.Mitigations.MCU") use "sk-mitigations-mcu__" & MCU_Mitigations_Pkg & ".adb";
      for Body ("SK.Mitigations.VM_Entry") use "sk-mitigations-vm_entry__" & VM_Entry_Pkg & ".adb";
      for Body ("SK.Mitigations.VM_Entry.IBPB") use "sk-mitigations-vm_entry-ibpb__" & VM_Entry_Ibpb_Pkg & ".adb";
      for Body ("SK.Mitigations.VM_Entry.Verw") use "sk-mitigations-vm_entry-verw__" & VM_Entry_Verw_Pkg & ".adb";
      for Body ("SK.Mitigations.VM_Entry.L1D_Flush") use "sk-mitigations-vm_entry-l1d_flush__" & VM_Entry_L1d_Flush_Pkg & ".adb";
   end Naming;

end Kernel;
